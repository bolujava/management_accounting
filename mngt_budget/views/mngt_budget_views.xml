<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- IMAGE 1: Consolidated -->
    <record id="view_mngt_budget_period_form" model="ir.ui.view">
        <field name="name">mngt.budget.period.form</field>
        <field name="model">mngt.budget.period</field>
        <field name="arch" type="xml">
            <form string="2026 Consolidated">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="year"/>
                    </group>
                    <group>
                        <field name="total_net_revenue" string="NET REVENUE"/>
                        <field name="total_contribution" string="CONTRIBUTION"/>
                        <field name="total_profit_before_tax" string="PROFIT (LOSS) BEFORE TAXATION"/>
                        <field name="total_profit_after_tax" string="NET PROFIT/LOSS"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_mngt_sbu_form" model="ir.ui.view">
        <field name="name">mngt.sbu.form</field>
        <field name="model">mngt.sbu</field>
        <field name="arch" type="xml">
            <form string="DWBI 2026">
                <header>
                    <field name="state" widget="badge" readonly="1"/>
                    <button name="action_submit" string="Submit Budget" type="object" class="btn-primary" states="draft"/>
                    <button name="action_lock" string="Lock Budget" type="object" class="btn-secondary" states="submitted"/>
                    <button name="action_unlock" string="Unlock Budget" type="object" class="btn-secondary" states="locked"/>
                    <button name="action_save_snapshot" string="Save Snapshot" type="object" class="btn-secondary" states="draft,submitted"/>
                </header>

                <sheet>
                    <group>
                        <field name="period_id"/>
                        <field name="name"/>
                    </group>

                    <div class="o_form_label">
                        <button name="action_bulk_input" string="Bulk Input" type="object" class="btn-primary" states="draft,submitted"/>
                    </div>

                    <notebook attrs="{'invisible': [('state', '=', 'locked')]}">

                        <page string="SOCI">
                            <field name="soci_row_ids" mode="tree" create="false">
                                <tree string="SOCI" editable="bottom"
                                      decoration-bf="row_type in ('net_revenue', 'contribution', 'profit_before_tax', 'profit_after_tax', 'net_profit')"
                                      decoration-info="row_type in ('net_revenue', 'contribution')"
                                      decoration-warning="row_type == 'profit_before_tax'"
                                      decoration-success="row_type in ('profit_after_tax', 'net_profit')">
                                    <field name="sequence" widget="handle"/>
                                    <field name="row_name" string="SOCI Item"/>
                                    <field name="row_type" invisible="1"/>
                                    <field name="row_type"/>

                                    <!-- Full editable grid (Python enforces calculated rows) -->
                                    <field name="m1" string="January" sum="1"/>
                                    <field name="m2" string="February" sum="1"/>
                                    <field name="m3" string="March" sum="1"/>
                                    <field name="m4" string="April" sum="1"/>
                                    <field name="m5" string="May" sum="1"/>
                                    <field name="m6" string="June" sum="1"/>
                                    <field name="m7" string="July" sum="1"/>
                                    <field name="m8" string="August" sum="1"/>
                                    <field name="m9" string="September" sum="1"/>
                                    <field name="m10" string="October" sum="1"/>
                                    <field name="m11" string="November" sum="1"/>
                                    <field name="m12" string="December" sum="1"/>

                                    <field name="q1" readonly="1" string="1st Q Total" sum="1"/>
                                    <field name="q2" readonly="1" string="2nd Q Total" sum="1"/>
                                    <field name="q3" readonly="1" string="3rd Q Total" sum="1"/>
                                    <field name="q4" readonly="1" string="4th Q Total" sum="1"/>
                                    <field name="grand_total" readonly="1" string="Grand Total" sum="1"/>
                                </tree>
                            </field>
                        </page>

                        <!-- IMAGE 6: OPERATING EXPENDITURE -->
                        <page string="Operating Expenditure">
                            <h4><strong>OPERATING EXPENDITURE</strong></h4>
                            <field name="expense_line_ids" mode="tree" create="false" editable="bottom">
                                <tree string="Expense Lines" editable="bottom" delete="false">
                                    <field name="sequence" widget="handle"/>
                                    <field name="row_name" string="Expense Item"/>
                                    <field name="justification" string="Justification"/>
                                    <field name="m1" string="January" sum="1"/>
                                    <field name="m2" string="February" sum="1"/>
                                    <field name="m3" string="March" sum="1"/>
                                    <field name="m4" string="April" sum="1"/>
                                    <field name="m5" string="May" sum="1"/>
                                    <field name="m6" string="June" sum="1"/>
                                    <field name="m7" string="July" sum="1"/>
                                    <field name="m8" string="August" sum="1"/>
                                    <field name="m9" string="September" sum="1"/>
                                    <field name="m10" string="October" sum="1"/>
                                    <field name="m11" string="November" sum="1"/>
                                    <field name="m12" string="December" sum="1"/>
                                    <field name="q1" readonly="1" string="1st Q Total" sum="1"/>
                                    <field name="q2" readonly="1" string="2nd Q Total" sum="1"/>
                                    <field name="q3" readonly="1" string="3rd Q Total" sum="1"/>
                                    <field name="q4" readonly="1" string="4th Q Total" sum="1"/>
                                    <field name="grand_total" readonly="1" string="Grand Total" sum="1"/>
                                </tree>
                            </field>
                        </page>

                        <!-- IMAGE 2: On-Shore Ongoing Implementation -->
                        <page string="On-Shore: Ongoing Impl">
                            <h4><strong>ONGOING IMPLEMENTATION</strong></h4>
                            <field name="onshore_impl_ids" mode="tree" editable="bottom" context="{'default_location_type': 'onshore', 'default_proj_category': 'ongoing_impl'}">
                                <tree string="On-Shore Impl">
                                    <field name="proj_category" invisible="1"/>
                                    <field name="client_name" string="Client Name"/>
                                    <field name="product" string="Product"/>
                                    <field name="justification" string="Justification"/>
                                    <field name="total_amount" string="Total Amount"/>
                                    <field name="m1" string="January" sum="1"/>
                                    <field name="m2" string="February" sum="1"/>
                                    <field name="m3" string="March" sum="1"/>
                                    <field name="m4" string="April" sum="1"/>
                                    <field name="m5" string="May" sum="1"/>
                                    <field name="m6" string="June" sum="1"/>
                                    <field name="m7" string="July" sum="1"/>
                                    <field name="m8" string="August" sum="1"/>
                                    <field name="m9" string="September" sum="1"/>
                                    <field name="m10" string="October" sum="1"/>
                                    <field name="m11" string="November" sum="1"/>
                                    <field name="m12" string="December" sum="1"/>
