    <record id="view_mngt_bulk_input_wizard_form" model="ir.ui.view">
        <field name="name">mngt.bulk.input.wizard.form</field>
        <field name="model">mngt.bulk.input.wizard</field>
        <field name="arch" type="xml">
            <form string="Bulk Input Clients">
                <sheet>
                    <group>
                        <field name="sbu_id" readonly="1"/>
                    </group>
                    <group>
                        <button name="action_download_template" string="1. Download Master Template" type="object" class="btn-secondary"/>
                        <field name="file_to_import" string="2. Upload Filled Excel Here"/>
                        <button name="action_import_file" string="3. Import into All Tabs" type="object" class="btn-primary"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- MoM List View -->
    <record id="view_mngt_sbu_tree" model="ir.ui.view">
        <field name="name">mngt.sbu.tree</field>
        <field name="model">mngt.sbu</field>
        <field name="arch" type="xml">
            <tree string="SBU Summary">
                <field name="name"/>
                <field name="annual_net_revenue" sum="1"/>
                <field name="annual_contribution" sum="1"/>
                <field name="annual_profit_after_tax" sum="1"/>
            </tree>
        </field>
    </record>
</odoo>