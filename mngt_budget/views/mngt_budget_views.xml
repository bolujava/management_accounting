                            <field name="onshore_prospective_ids" mode="tree" editable="bottom" context="{'default_location_type': 'onshore', 'default_proj_category': 'prospective_clients'}">
                                <tree string="On-Shore Prospective">
                                    <field name="proj_category" invisible="1"/>
                                    <field name="client_name" string="Client Name"/>
                                    <field name="product" string="Product"/>
                                    <field name="justification" string="Justification"/>
