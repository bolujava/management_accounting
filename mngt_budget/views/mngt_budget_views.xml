                                    <field name="m9" string="September" sum="1"/>
                                    <field name="m10" string="October" sum="1"/>
                                    <field name="m11" string="November" sum="1"/>
                                    <field name="m12" string="December" sum="1"/>
                                </tree>
                            </field>
                        </page>

                        <page string="Off-Shore: Prospective">
                            <h4><strong>PROJECTS FROM PROSPECTIVE FINTRAK CLIENTS</strong></h4>
                            <field name="offshore_prospective_ids" mode="tree" editable="bottom" context="{'default_location_type': 'offshore', 'default_proj_category': 'prospective_clients'}">
                                <tree string="Off-Shore Prospective">
                                    <field name="proj_category" invisible="1"/>
                                    <field name="client_name" string="Client Name"/>
                                    <field name="product" string="Product"/>
                                    <field name="justification" string="Justification"/>
                                    <field name="usd" string="Amount (USD)"/>
                                    <field name="exchange_rate" string="Exchange Rate"/>
                                    <field name="total_ngn" readonly="1" string="Total NGN"/>
                                    <field name="m1" string="January" sum="1"/>
                                    <field name="m2" string="February" sum="1"/>
                                    <field name="m3" string="March" sum="1"/>
                                    <field name="m4" string="April" sum="1"/>
                                    <field name="m5" string="May" sum="1"/>
                                    <field name="m6" string="June" sum="1"/>
                                    <field name="m7" string="July" sum="1"/>
                                    <field name="m8" string="August" sum="1"/>
                                    <field name="m9" string="September" sum="1"/>
                                    <field name="m10" string="October" sum="1"/>
                                    <field name="m11" string="November" sum="1"/>
                                    <field name="m12" string="December" sum="1"/>
                                </tree>
                            </field>
                        </page>

                        <!-- NEW: AMC Tabs -->
                        <page string="On-Shore: AMC">
                            <h4><strong>ANNUAL MAINTENANCE CHARGE (AMC)</strong></h4>
                            <field name="onshore_amc_ids" mode="tree" editable="bottom" context="{'default_location_type': 'onshore', 'default_proj_category': 'amc'}">
                                <tree string="On-Shore AMC">
                                    <field name="proj_category" invisible="1"/>
                                    <field name="client_name" string="Client Name"/>
                                    <field name="product" string="Product"/>
                                    <field name="justification" string="Justification"/>
                                    <field name="total_amount" string="Total Amount"/>
                                    <field name="m1" string="January" sum="1"/>
                                    <field name="m2" string="February" sum="1"/>
                                    <field name="m3" string="March" sum="1"/>
                                    <field name="m4" string="April" sum="1"/>
                                    <field name="m5" string="May" sum="1"/>
                                    <field name="m6" string="June" sum="1"/>
                                    <field name="m7" string="July" sum="1"/>
                                    <field name="m8" string="August" sum="1"/>
                                    <field name="m9" string="September" sum="1"/>
                                    <field name="m10" string="October" sum="1"/>
                                    <field name="m11" string="November" sum="1"/>
                                    <field name="m12" string="December" sum="1"/>
                                </tree>
                            </field>
                        </page>

                        <page string="Off-Shore: AMC">
                            <h4><strong>ANNUAL MAINTENANCE CHARGE (AMC)</strong></h4>
                            <field name="offshore_amc_ids" mode="tree" editable="bottom" context="{'default_location_type': 'offshore', 'default_proj_category': 'amc'}">
