                                    <field name="m12" string="December" sum="1"/>
                                </tree>
                            </field>
                        </page>

                        <!-- IMAGE 7: MoM Summary (Exact Grid with Super Headings & Colors) -->
                        <page string="MoM Summary">
                            <group string="Quarterly Inflation Rate">
                                <field name="q1_inflation_rate" string="Q1 Inflation Rate (%)"/>
                                <field name="q2_inflation_rate" string="Q2 Inflation Rate (%)"/>
                                <field name="q3_inflation_rate" string="Q3 Inflation Rate (%)"/>
                                <field name="q4_inflation_rate" string="Q4 Inflation Rate (%)"/>
                            </group>
                            <separator string=""/>

                            <field name="summary_line_ids" mode="tree" create="false">
                                <tree string="2026 Summary" editable="bottom"
                                      decoration-info="row_name in ('ON SHORE GROSS REVENUE', 'OFF SHORE GROSS REVENUE', 'TOTAL GROSS REVENUE')"
                                      decoration-success="row_name in ('Total On Shore Gross Revenue', 'Total Off Shore Gross Revenue', 'Total Gross Revenue')"
                                      decoration-warning="row_name in ('EXPENSES', 'Total Expenses')"
                                      decoration-danger="row_name in ('Profit Before Tax', 'Tax', 'Net Profit')"
                                      decoration-bf="row_name in ('ON SHORE GROSS REVENUE', 'OFF SHORE GROSS REVENUE', 'TOTAL GROSS REVENUE', 'EXPENSES', 'Total On Shore Gross Revenue', 'Total Off Shore Gross Revenue', 'Total Gross Revenue', 'Total Expenses', 'Profit Before Tax', 'Tax', 'Net Profit')">

                                    <field name="sequence" widget="handle"/>
                                    <field name="row_name" string="Row Name"/>
                                    <field name="m1" string="Jan"/>
                                    <field name="m2" string="Feb"/>
                                    <field name="m3" string="Mar"/>
                                    <field name="q1" readonly="1" string="1st Q"/>
                                    <field name="m4" string="Apr"/>
                                    <field name="m5" string="May"/>
                                    <field name="m6" string="Jun"/>
                                    <field name="q2" readonly="1" string="2nd Q"/>
                                    <field name="m7" string="Jul"/>
                                    <field name="m8" string="Aug"/>
                                    <field name="m9" string="Sep"/>
                                    <field name="q3" readonly="1" string="3rd Q"/>
                                    <field name="m10" string="Oct"/>
                                    <field name="m11" string="Nov"/>
                                    <field name="m12" string="Dec"/>
                                    <field name="q4" readonly="1" string="4th Q"/>
                                    <field name="annual_total" readonly="1" string="Annual Total"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Audit Trail">
                            <field name="audit_log_ids" readonly="1">
                                <tree string="Audit Trail">
                                    <field name="create_date" string="Date"/>
                                    <field name="user_id" string="Action By"/>
                                    <field name="action" string="Action"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Value Snapshots">
                            <field name="snapshots" readonly="1">
                                <tree string="Budget Snapshots">
                                    <field name="create_date" string="Saved On"/>
                                    <field name="user_id" string="Saved By"/>
                                    <field name="net_revenue_total" string="Net Revenue"/>
                                    <field name="contribution_total" string="Contribution"/>
                                    <field name="net_profit_total" string="Net Profit"/>
                                    <field name="comment" string="Comment"/>
                                </tree>
                            </field>
                        </page>
